SELECT source_id,ra,dec,parallax,pmra,pmdec,radial_velocity,ref_epoch,ra_error,dec_error,parallax_error,pmra_error,pmdec_error,radial_velocity_error,ruwe,phot_g_mean_mag,ra_dec_corr,ra_parallax_corr,ra_pmra_corr,ra_pmdec_corr,dec_parallax_corr,dec_pmra_corr,dec_pmdec_corr,parallax_pmra_corr,parallax_pmdec_corr,pmra_pmdec_corr FROM gaiadr3.gaia_source WHERE parallax >= 50 AND parallax_over_error > 20 AND radial_velocity IS NOT NULL AND ruwe < 1.4 AND visibility_periods_used >= 10 ORDER BY source_id
